# =============================================================================
# .env.example — 환경 변수 예시
#
# 이 파일은 부트스트랩 시점에 .env로 복사됩니다.
# /setup-project가 .claude/stack.json을 보고 스택별 섹션을 활성화/비활성화합니다.
# 시크릿 값은 SETUP.sh가 openssl rand로 강한 값으로 자동 교체합니다.
# =============================================================================

# -----------------------------------------------------------------------------
# [Common] 공통 — 모든 스택에서 사용
# -----------------------------------------------------------------------------
PROJECT_NAME=your_project_name
LOG_LEVEL=INFO

# 배포
DOCKER_REGISTRY=ghcr.io
DOCKER_NAMESPACE=your_github_org

# -----------------------------------------------------------------------------
# [Database — PostgreSQL] 스택 선택 시 활성화
# -----------------------------------------------------------------------------
POSTGRES_DB=project_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=__GENERATED_BY_SETUP__
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# -----------------------------------------------------------------------------
# [Database — MySQL] (PostgreSQL 대신 MySQL 선택 시)
# -----------------------------------------------------------------------------
# MYSQL_DATABASE=project_dev
# MYSQL_USER=app
# MYSQL_PASSWORD=__GENERATED_BY_SETUP__
# MYSQL_ROOT_PASSWORD=__GENERATED_BY_SETUP__
# DATABASE_URL=mysql+pymysql://${MYSQL_USER}:${MYSQL_PASSWORD}@mysql:3306/${MYSQL_DATABASE}

# -----------------------------------------------------------------------------
# [Database — MongoDB] (관계형 DB 대신 MongoDB 선택 시)
# -----------------------------------------------------------------------------
# MONGO_INITDB_ROOT_USERNAME=root
# MONGO_INITDB_ROOT_PASSWORD=__GENERATED_BY_SETUP__
# MONGO_INITDB_DATABASE=project_dev
# DATABASE_URL=mongodb://${MONGO_INITDB_ROOT_USERNAME}:${MONGO_INITDB_ROOT_PASSWORD}@mongo:27017/${MONGO_INITDB_DATABASE}

# -----------------------------------------------------------------------------
# [Cache — Redis] (선택)
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# [Backend API] 스택별로 BACKEND_PORT/HEALTH_PATH가 다를 수 있음
# -----------------------------------------------------------------------------
API_HOST=http://backend:8000
BACKEND_PORT=8000
HEALTH_PATH=/health           # FastAPI/Django: /health, Express: /healthz, Spring: /actuator/health

# -----------------------------------------------------------------------------
# [Frontend] 스택별 환경 변수 이름이 다름 (다음 중 하나만 사용)
# -----------------------------------------------------------------------------
# Vite (React/Vue/Svelte):
FRONTEND_URL=http://localhost:5173
# VITE_API_URL=http://localhost:8000

# Next.js:
# FRONTEND_URL=http://localhost:3000
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Create React App (legacy):
# REACT_APP_API_URL=http://localhost:8000

# Nuxt:
# NUXT_PUBLIC_API_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# [Auth — JWT] 인증 방식이 JWT일 때만 필요
# -----------------------------------------------------------------------------
JWT_SECRET=__GENERATED_BY_SETUP__
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7

# -----------------------------------------------------------------------------
# [Auth — Session] (JWT 대신 세션 기반 인증 선택 시)
# -----------------------------------------------------------------------------
# SESSION_SECRET=__GENERATED_BY_SETUP__
# SESSION_COOKIE_NAME=session_id
# SESSION_MAX_AGE_HOURS=24

# -----------------------------------------------------------------------------
# [Auth — OAuth] (소셜 로그인 사용 시)
# -----------------------------------------------------------------------------
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# [MCP 서버] .mcp.json 참조
# -----------------------------------------------------------------------------
# Notion MCP — 미설정 시 Notion 통합 비활성화
NOTION_API_KEY=

# -----------------------------------------------------------------------------
# [Storage] 선택한 파일 저장소에 따라 활성화
# -----------------------------------------------------------------------------
# AWS S3:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=

# GCP Cloud Storage:
# GCP_PROJECT_ID=
# GCP_CREDENTIALS_PATH=
# GCS_BUCKET=

# -----------------------------------------------------------------------------
# [Email] 메일 서비스 사용 시
# -----------------------------------------------------------------------------
# SENDGRID_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
